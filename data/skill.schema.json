{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill.schema.json",
  "title": "Skill",
  "description": "Master skill data, separate from whether a particular course teaches it or a particular person has it.",
  "$comment": "Portable prototype model. Domain meaning is informed by the source files; this is intentionally NOT their legacy payload format. See README.md for mapping decisions.",
  "x-data-kind": "source-data",
  "x-source-files": [
    "includes/namespaces/skillsapi.inc",
    "includes/classes/packet/packet_skillabi.class.inc"
  ],
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "type": {
      "enum": [
        "specialized",
        "common",
        "certification"
      ]
    },
    "isSoftware": {
      "type": "boolean"
    },
    "category": {
      "$ref": "common.schema.json#/definitions/namedReference"
    },
    "subcategory": {
      "$ref": "common.schema.json#/definitions/namedReference"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name"
  ],
  "examples": [
    {
      "id": "skill-programming",
      "name": "Programming",
      "type": "specialized",
      "isSoftware": false
    }
  ]
}
