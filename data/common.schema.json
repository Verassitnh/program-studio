{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Shared domain values",
  "description": "Reusable values, not an application payload. Identifiers and classification codes remain strings.",
  "$comment": "Portable prototype model. Domain meaning is informed by the source files; this is intentionally NOT their legacy payload format. See README.md for mapping decisions.",
  "x-data-kind": "shared-value",
  "x-source-files": [
    "includes/namespaces/curricularskillsapi.inc",
    "includes/namespaces/alumnipathwaysapi.inc",
    "includes/classes/packet/packet_skillabi.class.inc",
    "includes/classes/packet/packet_alumni_pathways.class.inc"
  ],
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "object",
      "properties": {
        "taxonomyId": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "taxonomyId",
        "code"
      ]
    },
    "namedReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
      "description": "ISO year, year-month, or date. Preserve source precision; do not invent a day for year-only data."
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "common.schema.json#/definitions/date"
        },
        "end": {
          "$ref": "common.schema.json#/definitions/date"
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ]
    },
    "wage": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "enum": [
            "hour",
            "year"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "period"
      ]
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "yearsAfterEducation": {
          "type": "integer",
          "minimum": 0
        },
        "openEnded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "yearsAfterEducation",
        "openEnded"
      ]
    }
  },
  "examples": [
    {}
  ]
}
